{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/mcp",
      "destination": "/api/mcp.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
